# Configuration du serveur — specs 017, 020, 021.
#
#   cp .env.example .env
#
# `npm start` et `npm run dev` chargent `.env` s'il existe. En production, ces
# mêmes variables viennent du gestionnaire de service, pas de ce fichier — voir
# `EnvironmentFile` dans deploiement/babo.service.

# Port d'écoute. TLS est terminé par le proxy en amont, pas par Express.
BABO_PORT=3000

# Chemin du fichier SQLite unique. C'est ce fichier qu'on recopie pour
# sauvegarder (spec 023).
BABO_BASE_CHEMIN=data/babo.db

# Clé de chiffrement de la base, au repos. Aucune valeur par défaut : sans
# elle, l'application refuse de démarrer.
#   openssl rand -base64 32
# Elle ne voyage pas avec la sauvegarde et ne vit pas uniquement sur le serveur
# sauvegardé : une base chiffrée dont la clé a brûlé avec la machine est un
# fichier inutile (spec 023).
BABO_BASE_CLE=

# `false` seulement si l'application est exposée sans proxy devant elle.
BABO_DERRIERE_UN_PROXY=true

# Ma licence fédérale. Elle désigne les pages que l'acquisition va chercher
# (spec 015) : sans elle, l'application ne sait pas de qui elle parle.
BABO_LICENCE=

# Le mot de passe qui ouvre Babo (spec 021). Aucune valeur par défaut : sans
# lui, l'application refuse de démarrer, parce qu'une porte sans serrure ne vaut
# pas mieux que pas de porte. C'est cette variable qui fait foi : la changer et
# redémarrer change le mot de passe, il n'y a pas d'écran pour ça.
# L'identifiant, lui, est le numéro de licence ci-dessus — il n'est pas secret,
# tout tient donc à ce mot de passe : le prendre long.
BABO_MOT_DE_PASSE=

# Le secret qui signe les jetons de session (spec 021). Jamais en base : il
# protège justement ce qui y est rangé.
#   openssl rand -base64 32
# Le changer déconnecte tout le monde d'un coup — c'est le seul moyen d'annuler
# une session, un jeton sans état ne se révoquant pas.
BABO_SECRET_JETON=

# Mot de passe myffbad. Facultatif : renseigné, Babo renouvelle sa session tout
# seul (myffbad n'a pas de 2FA) ; laissé vide, la session s'enregistre à la
# main depuis /sources. badnet, lui, exigera toujours la main : il a une 2FA.
BABO_MYFFBAD_MOT_DE_PASSE=

# Le SMTP par lequel les mails partent — spec 016. Alertes de panne et
# battement hebdomadaire (019), alertes de tournoi (013), rappels (014).
#
# Facultatif : sans ces variables, l'application démarre quand même, les
# messages sont écrits en base et personne ne les remet — /sources le dit. Il
# faut les cinq (hôte, utilisateur, mot de passe, expéditeur, destinataire) :
# une configuration à moitié remplie ne vaut pas mieux qu'aucune, elle ferait
# croire qu'on alerte alors qu'on n'alerte pas.
BABO_SMTP_HOTE=smtp.gmail.com

# 465, et le chiffrement s'en déduit : TLS dès le premier octet, sans bascule
# STARTTLS en cours de dialogue. Ne pas en changer sans raison — un autre port
# ouvre une session non chiffrée.
BABO_SMTP_PORT=465

# Le compte Gmail. Le mot de passe est un *mot de passe d'application* Google,
# jamais celui du compte : Google l'exige, et il suppose la validation en deux
# étapes activée. https://myaccount.google.com/apppasswords
BABO_SMTP_UTILISATEUR=
BABO_SMTP_MOT_DE_PASSE=

# Gmail impose que l'expéditeur soit le compte authentifié ou l'un de ses
# alias. Le destinataire est unique — moi : 008 a retiré les mails des
# coéquipiers de l'import de 005, il n'y a personne d'autre à qui écrire.
BABO_MAIL_EXPEDITEUR=
BABO_MAIL_DESTINATAIRE=

# Mot de passe badnet — spec 027. Facultatif : renseigné, Babo mène la connexion
# et ne demande que le code de vérification reçu par mail ; laissé vide, la
# session se colle à la main depuis /sources, comme avant.
#
# L'identifiant n'est pas ici : badnet attend le numéro de licence ci-dessus,
# à huit chiffres, zéros de tête compris. Une seconde variable qui devrait
# toujours valoir la première serait une occasion de les désaccorder.
BABO_BADNET_MOT_DE_PASSE=
