# Configuration du serveur — specs 017, 020, 021.
#
#   cp .env.example .env
#
# `npm start` et `npm run dev` chargent `.env` s'il existe. En production, ces
# mêmes variables viennent du gestionnaire de service, pas de ce fichier — voir
# `EnvironmentFile` dans deploiement/babo.service.

# Port d'écoute. TLS est terminé par le proxy en amont, pas par Express.
BABO_PORT=3000

# Chemin du fichier SQLite unique. C'est ce fichier qu'on recopie pour
# sauvegarder (spec 023).
BABO_BASE_CHEMIN=data/babo.db

# Clé de chiffrement de la base, au repos. Aucune valeur par défaut : sans
# elle, l'application refuse de démarrer.
#   openssl rand -base64 32
# Elle ne voyage pas avec la sauvegarde et ne vit pas uniquement sur le serveur
# sauvegardé : une base chiffrée dont la clé a brûlé avec la machine est un
# fichier inutile (spec 023).
BABO_BASE_CLE=

# `false` seulement si l'application est exposée sans proxy devant elle.
BABO_DERRIERE_UN_PROXY=true
