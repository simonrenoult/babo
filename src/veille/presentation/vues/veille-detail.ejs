<%- include("entete", { titre }) %>
<h2><%= titre %></h2>

<% if (!veille.active) { %>
  <p class="etat attention">
    Veille suspendue : elle ne cherche plus et n'alerte plus. Ce qu'elle a déjà
    vu est conservé.
  </p>
<% } %>

<p class="discret">
  Dans un rayon de <%= veille.rayonKm %> km autour de
  <%= veille.latitude.toFixed(4) %>, <%= veille.longitude.toFixed(4) %> —
  à vol d'oiseau.
  <% if (veille.fenetre.nature === "glissante") { %>
    Tournois des <%= veille.fenetre.jours %> prochains jours,
  <% } else { %>
    Tournois du <%= fenetre.du.toLocaleDateString("fr-FR") %> au
    <%= fenetre.au.toLocaleDateString("fr-FR") %>,
  <% } %>
  en <%= veille.tableaux.join(", ") %>, séries <%= veille.series.join(", ") %><%
  if (veille.categories.length > 0) { %>, <%= veille.categories.join(", ") %><% } %><%
  if (veille.ouvertes) { %>, inscriptions encore ouvertes<% } %>.
</p>

<%- include("peremption", { fraicheur }) %>

<%
  /*
    Trois silences très différents, et la page les disait tous les trois de la
    même façon — « aucun tournoi ne répond à ces critères », y compris quand
    personne n'avait encore cherché. C'est la distinction que 019 impose
    ailleurs : « jamais relevée » n'est pas « rien trouvé ».
  */
%>
<% if (resultats.retenus.length === 0 && releveeLe === null) { %>
  <p class="etat">
    <strong>Cette veille n'a pas encore été relevée.</strong>
    La recherche tourne chaque matin à 5 h 15 : les premiers résultats
    apparaîtront demain matin.
  </p>
<% } else if (resultats.retenus.length === 0 && resultats.enAttenteDeFiche === 0
              && resultats.ecartes === 0 && resultats.indetermines.length === 0) { %>
  <p class="etat">
    <strong>La dernière recherche n'a rien rendu dans ce périmètre</strong>
    (<%= releveeLe.toLocaleString("fr-FR") %>). badnet n'y publie aucun tournoi
    à venir : c'est le rayon ou la fenêtre qu'il faut élargir.
  </p>
<% } else if (resultats.retenus.length === 0) { %>
  <p class="etat">
    <strong>Aucun tournoi ne répond à ces critères</strong>
    (relevé le <%= releveeLe.toLocaleString("fr-FR") %>).
    badnet en a rendu <%= resultats.ecartes + resultats.indetermines.length + resultats.enAttenteDeFiche %>
    dans le périmètre : ce sont les tableaux, les séries ou la fenêtre qui les écartent.
  </p>
<% } else { %>
  <table>
    <tr>
      <th>Tournoi</th>
      <th>Quand</th>
      <th>Où</th>
      <th class="nombre">Distance</th>
      <th>Tableaux</th>
      <th>Inscription avant</th>
    </tr>
    <% resultats.retenus.forEach(function (t) { %>
      <tr>
        <td><a href="<%= t.fiche %>" target="_blank" rel="noreferrer"><%= t.nom %></a></td>
        <td><%= t.quand %></td>
        <td><%= t.ville === null ? "lieu non relevé" : t.ville %></td>
        <td class="nombre"><%= t.distanceKm === null ? "—" : t.distanceKm + " km" %></td>
        <td><%= t.tableaux.join(", ") %></td>
        <td><%= t.dateLimite === null ? "—" : t.dateLimite.toLocaleDateString("fr-FR") %></td>
      </tr>
    <% }); %>
  </table>
<% } %>

<% if (resultats.indetermines.length > 0) { %>
  <h3>Tableaux non déclarés
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Dans le périmètre, mais sans tableaux ni séries saisis : le plus souvent des tournois
        fraîchement publiés, ceux qui se remplissent le plus vite.</span>
    </span></span>
  </h3>
  <table>
    <tr><th>Tournoi</th><th>Quand</th><th>Où</th><th class="nombre">Distance</th><th>Inscription avant</th></tr>
    <% resultats.indetermines.forEach(function (t) { %>
      <tr>
        <td><a href="<%= t.fiche %>" target="_blank" rel="noreferrer"><%= t.nom %></a></td>
        <td><%= t.quand %></td>
        <td><%= t.ville === null ? "lieu non relevé" : t.ville %></td>
        <td class="nombre"><%= t.distanceKm === null ? "—" : t.distanceKm + " km" %></td>
        <td><%= t.dateLimite === null ? "—" : t.dateLimite.toLocaleDateString("fr-FR") %></td>
      </tr>
    <% }); %>
  </table>
<% } %>

<p class="discret">
  <%= resultats.ecartes %> tournoi<%= resultats.ecartes > 1 ? "s" : "" %> écarté<%= resultats.ecartes > 1 ? "s" : "" %> par les critères.
  <% if (resultats.enAttenteDeFiche > 0) { %>
    <%= resultats.enAttenteDeFiche %> en attente de leur fiche : ils apparaîtront demain.
  <% } %>
</p>

<h3>Gérer cette veille</h3>
<p><a href="/veille/<%= veille.id %>/modifier">Modifier les critères</a></p>

<form method="post" action="/veille/<%= veille.id %>/etat">
  <input type="hidden" name="active" value="<%= veille.active ? "0" : "1" %>">
  <button type="submit"><%= veille.active ? "Suspendre" : "Réactiver" %></button>
</form>

<form method="post" action="/veille/<%= veille.id %>/supprimer">
  <button type="submit" class="danger">Supprimer</button>
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Supprimer oublie ce que la veille a vu ; suspendre le garde.</span>
  </span></span>
</form>

<p><a href="/veille">Retour aux veilles</a></p>
<%- include("pied") %>
