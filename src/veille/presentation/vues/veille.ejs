<%- include("entete", { titre }) %>
<h2><%= titre %>
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Des recherches nommées, relancées chaque matin sur badnet. Cinq au plus.</span>
  </span></span>
</h2>
<div class="barre-actions">
  <% if (veilles.length < auPlus) { %>
    <a class="bouton principal" href="/veille/nouvelle">Créer une veille</a>
  <% } else { %>
    <%# Le message prend la place du geste : là où on le cherche, il dit pourquoi il manque. %>
    <p class="etat">
      Cinq veilles, le maximum. Pour en créer une autre, il faut en supprimer une.
    </p>
  <% } %>
</div>

<% if (veilles.length === 0) { %>
  <p class="etat">
    Aucune veille. La première se crée en une minute : un nom, un point de
    départ, un rayon, une fenêtre de dates, les tableaux que je joue et les
    séries où je suis admis.
  </p>
<% } else { %>
  <%- include("peremption", { fraicheur }) %>

  <table>
    <tr>
      <th>Veille</th>
      <th>Périmètre</th>
      <th>Tableaux</th>
      <th>Séries</th>
      <th class="nombre">Tournois</th>
      <th>État</th><%
      /* « — » et « jamais relevée » plutôt qu'un zéro : un décompte nul se lit
         comme un résultat, alors qu'aucune recherche n'a encore eu lieu. */ %>
    </tr>
    <% veilles.forEach(function (ligne) { %>
      <tr>
        <td><a href="/veille/<%= ligne.veille.id %>"><%= ligne.veille.nom %></a></td>
        <td><%= ligne.veille.rayonKm %> km</td>
        <td><%= ligne.veille.tableaux.join(", ") %></td>
        <td><%= ligne.veille.series.join(", ") %></td>
        <td class="nombre">
          <%= ligne.releveeLe === null ? "—" : ligne.vus %>
        </td>
        <td>
          <% if (ligne.releveeLe === null) { %>
            jamais relevée
          <% } else { %>
            <%= ligne.veille.active ? "active" : "suspendue" %>
          <% } %>
        </td>
      </tr>
    <% }); %>
  </table>
<% } %>

<%- include("pied") %>
