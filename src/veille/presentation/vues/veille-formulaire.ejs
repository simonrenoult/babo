<%- include("entete", { titre }) %>
<h2><%= titre %></h2>
<div class="barre-actions">
  <%- include("retour", retour) %>
</div>

<% if (motifs.length > 0) { %>
  <div class="etat erreur">
    <strong>Rien n'a été enregistré :</strong>
    <ul>
      <% motifs.forEach(function (motif) { %><li><%= motif %></li><% }); %>
    </ul>
  </div>
<% } %>

<form method="post" action="<%= veille === null || veille.id === 0 ? "/veille" : "/veille/" + veille.id %>">
  <p>
    <label>Nom
      <input type="text" name="nom" required maxlength="60"
             value="<%= veille === null ? "" : veille.nom %>"
             placeholder="DH avec Louis">
    </label>
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Il dira, dans le mail d'alerte, pourquoi ce tournoi m'est signalé.</span>
    </span></span>
  </p>

  <h3>Périmètre
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Un point et un rayon, à vol d'oiseau.</span>
    </span></span>
  </h3>
  <p>
    <label>Latitude
      <input type="number" step="any" name="latitude" required
             value="<%= veille === null ? "48.8534" : veille.latitude %>">
    </label>
    <label>Longitude
      <input type="number" step="any" name="longitude" required
             value="<%= veille === null ? "2.3488" : veille.longitude %>">
    </label>
    <label>Rayon (km)
      <input type="number" name="rayonKm" min="1" max="500" required
             value="<%= veille === null ? 50 : veille.rayonKm %>">
    </label>
  </p>

  <h3>Fenêtre de dates</h3>
  <p>
    <label>
      <input type="radio" name="fenetre" value="glissante"
             <%= veille === null || veille.fenetre.nature === "glissante" ? "checked" : "" %>>
      Glissante, sur
    </label>
    <input type="number" name="fenetreJours" min="1" max="365"
           value="<%= veille !== null && veille.fenetre.nature === "glissante" ? veille.fenetre.jours : 90 %>">
    jours
  </p>
  <p>
    <label>
      <input type="radio" name="fenetre" value="intervalle"
             <%= veille !== null && veille.fenetre.nature === "intervalle" ? "checked" : "" %>>
      Du
    </label>
    <input type="date" name="fenetreDu"
           value="<%= veille !== null && veille.fenetre.nature === "intervalle" ? veille.fenetre.du.toISOString().slice(0, 10) : "" %>">
    au
    <input type="date" name="fenetreAu"
           value="<%= veille !== null && veille.fenetre.nature === "intervalle" ? veille.fenetre.au.toISOString().slice(0, 10) : "" %>">
  </p>

  <h3>Tableaux</h3>
  <p>
    <% tousLesTableaux.forEach(function (tableau) { %>
      <label>
        <input type="checkbox" name="tableaux" value="<%= tableau %>"
               <%= veille !== null && veille.tableaux.includes(tableau) ? "checked" : "" %>>
        <%= intitules[tableau] %>
      </label>
    <% }); %>
  </p>

  <h3>Séries admises
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Cochées par défaut : mes séries du moment. Elles ne suivent pas mon classement ensuite —
        une paire entre par la série la plus haute des deux.</span>
    </span></span>
  </h3>
  <p>
    <% toutesLesSeries.forEach(function (serie) { %>
      <label>
        <input type="checkbox" name="series" value="<%= serie %>"
               <%= (veille === null ? seriesProposees : veille.series).includes(serie) ? "checked" : "" %>>
        <%= serie %>
      </label>
    <% }); %>
  </p>

  <h3>Catégories d'âge
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Aucune cochée : toutes.</span>
    </span></span>
  </h3>
  <p>
    <% toutesLesCategories.forEach(function (categorie) { %>
      <label>
        <input type="checkbox" name="categories" value="<%= categorie %>"
               <%= veille !== null && veille.categories.includes(categorie) ? "checked" : "" %>>
        <%= categorie %>
      </label>
    <% }); %>
  </p>

  <p>
    <label>
      <input type="checkbox" name="ouvertes" value="1"
             <%= veille === null || veille.ouvertes ? "checked" : "" %>>
      Seulement les tournois dont les inscriptions ne sont pas closes
    </label>
  </p>

  <p><button type="submit" class="principal">Enregistrer</button></p>
</form>

<%- include("pied") %>
