<%- include("entete", { titre }) %>


<%# Deux niveaux d'onglets, portés par la page et non par l'entête : chaque %>
<%# module n'a pas à connaître les sous-pages du socle (033). %>
<nav class="onglets" aria-label="Paramètres">
  <% for (const groupe of groupes) { %>
    <a href="<%= groupe.onglets[0].chemin %>"
       <%- groupe.id === groupeCourant.id ? 'aria-current="page"' : "" %>><%= groupe.intitule %></a>
  <% } %>
</nav>

<% if (groupeCourant.onglets.length > 1) { %>
  <nav class="onglets sous" aria-label="<%= groupeCourant.intitule %>">
    <% for (const sous of groupeCourant.onglets) { %>
      <a href="<%= sous.chemin %>"
         <%- sous.id === onglet ? 'aria-current="page"' : "" %>><%= sous.intitule %></a>
    <% } %>
  </nav>
<% } %>

<%- include(`parametres/${onglet}`) %>

<%- include("pied") %>
