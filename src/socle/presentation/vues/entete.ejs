<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= titre %> — Babo</title>
  <style>
    :root { color-scheme: light dark; }
    body { margin: 0; font: 1rem/1.55 system-ui, sans-serif; }
    nav { display: flex; gap: 1rem; }
    .app { display: grid; grid-template-columns: 13rem minmax(0, 1fr); min-height: 100vh; }
    .app.nu { grid-template-columns: minmax(0, 1fr); }
    .menu { position: sticky; top: 0; height: 100vh; box-sizing: border-box;
            display: flex; flex-direction: column; gap: 1.25rem;
            padding: 1.5rem 1rem; border-right: 1px solid currentColor; }
    .menu h1 { margin: 0; font-size: 1.25rem; }
    .menu nav { flex-direction: column; gap: .25rem; }
    .menu nav a { padding: .3rem .5rem; border-radius: .25rem; }
    .menu nav a[aria-current] { font-weight: 600; text-decoration: none;
                                background: color-mix(in srgb, currentColor 10%, transparent); }
    .menu form { margin-top: auto; }
    .contenu { padding: 1.5rem; max-width: 52rem; }
    .contenu > header { border-bottom: 1px solid currentColor; padding-bottom: .75rem; }
    .contenu > header h1 { margin: 0; font-size: 1.25rem; }
    footer { margin-top: 2.5rem; padding-top: .75rem; border-top: 1px solid currentColor;
             font-size: .85rem; opacity: .7; }
    table { border-collapse: collapse; }
    .etat { padding: .5rem .75rem; border-left: 3px solid currentColor;
            background: color-mix(in srgb, currentColor 6%, transparent); }
    th, td { text-align: left; padding: .25rem .75rem .25rem 0; }

    /* Sur un téléphone, le menu repasse en bandeau au-dessus du contenu. */
    @media (max-width: 42rem) {
      .app { grid-template-columns: minmax(0, 1fr); }
      .menu { position: static; height: auto; flex-direction: row; flex-wrap: wrap;
              align-items: center; gap: .5rem 1rem; padding: 1rem;
              border-right: 0; border-bottom: 1px solid currentColor; }
      .menu nav { flex-direction: row; flex-wrap: wrap; }
      .menu form { margin-top: 0; margin-left: auto; }
      .contenu { padding: 1rem; }
    }
  </style>
</head>
<body>
<%# La page de connexion n'affiche aucune navigation : tout y mènerait à la %>
<%# même redirection, et lister les écrans à qui n'est pas entré n'apprend %>
<%# rien d'utile à celui qui a le mot de passe (spec 021). %>
<div class="app<%= locals.nu ? " nu" : "" %>">
<% if (!locals.nu) { %>
  <%
    const ici = locals.chemin ?? "";
    const actif = (prefixe) => ici === prefixe || ici.startsWith(`${prefixe}/`);
    const entrees = [...modules, { chemin: "/parametres", intitule: "Paramètres" }];
  %>
  <aside class="menu">
    <h1><a href="/">Babo</a></h1>
    <nav aria-label="Menu principal">
      <% for (const entree of entrees) { %>
        <a href="<%= entree.chemin %>"
           <%- actif(entree.chemin) ? 'aria-current="page"' : "" %>><%= entree.intitule %></a>
      <% } %>
    </nav>
    <form method="post" action="/connexion/deconnexion">
      <button type="submit">Se déconnecter</button>
    </form>
  </aside>
<% } %>
<div class="contenu">
<% if (locals.nu) { %>
  <header><h1>Babo</h1></header>
<% } %>
<main>
