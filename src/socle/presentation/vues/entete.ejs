<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= titre %> — Babo</title>
  <style>
    :root { color-scheme: light dark; }
    body {
      margin: 0 auto; padding: 1.5rem; max-width: 52rem;
      font: 1rem/1.55 system-ui, sans-serif;
    }
    header { display: flex; flex-wrap: wrap; gap: 1rem; align-items: baseline;
             border-bottom: 1px solid currentColor; padding-bottom: .75rem; }
    header h1 { margin: 0; font-size: 1.25rem; }
    nav { display: flex; gap: 1rem; }
    footer { margin-top: 2.5rem; padding-top: .75rem; border-top: 1px solid currentColor;
             font-size: .85rem; opacity: .7; }
    table { border-collapse: collapse; }
    .etat { padding: .5rem .75rem; border-left: 3px solid currentColor;
            background: color-mix(in srgb, currentColor 6%, transparent); }
    th, td { text-align: left; padding: .25rem .75rem .25rem 0; }
  </style>
</head>
<body>
<header>
  <h1><% if (locals.nu) { %>Babo<% } else { %><a href="/">Babo</a><% } %></h1>
  <%# La page de connexion n'affiche aucune navigation : tout y mènerait à la %>
  <%# même redirection, et lister les écrans à qui n'est pas entré n'apprend %>
  <%# rien d'utile à celui qui a le mot de passe (spec 021). %>
  <% if (!locals.nu) { %>
    <nav>
      <% for (const module of modules) { %>
        <a href="<%= module.chemin %>"><%= module.intitule %></a>
      <% } %>
      <a href="/sources">Sources</a>
    </nav>
    <form method="post" action="/connexion/deconnexion">
      <button type="submit">Se déconnecter</button>
    </form>
  <% } %>
</header>
<main>
