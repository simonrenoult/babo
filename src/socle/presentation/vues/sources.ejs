<%- include("entete", { titre }) %>

<h2>Sources</h2>
<p>
  Babo tire ses données de deux sites, chacun avec sa propre session : myffbad
  pour le classement et les matchs, badnet pour les tournois (spec 015). Une
  session tombée arrête le scraper de sa source, et elle seule.
</p>

<table>
  <tr>
    <th>Source</th><th>Session</th><th>Expire</th>
    <th>Dernière acquisition</th><th>Issue</th>
  </tr>
  <% for (const etat of etats) { %>
    <tr>
      <td><%= etat.source %></td>
      <td><%= { absente: "absente", expiree: "expirée", valide: "valide" }[etat.session] %></td>
      <td><%= etat.expireLe ? etat.expireLe.toLocaleDateString("fr-FR") : "—" %></td>
      <td>
        <%= etat.derniereAcquisition
              ? etat.derniereAcquisition.toLocaleString("fr-FR")
              : "jamais" %>
      </td>
      <td><%= etat.derniereIssue ?? "—" %></td>
    </tr>
  <% } %>
</table>

<h2>Ordonnancement</h2>
<p>
  Les tâches qui se déclenchent seules, et quand (spec 018). Le planificateur
  vit dans le processus : tant qu'il est arrêté, rien ne s'exécute et rien ne
  prévient — c'est le risque que 018 accepte, contre un service supervisé qui
  relance l'application.
</p>
<p>
  La <strong>grâce</strong> est le retard au-delà duquel une échéance dépassée
  n'est plus rejouée mais abandonnée : large pour une passe dont la donnée est
  de toute façon périmée, courte pour un rappel qui n'a de sens qu'avant
  l'événement. Un échec est réessayé deux fois, à une heure puis à quatre ;
  au-delà, la tâche attend son occurrence suivante.
</p>
<p>
  La colonne <strong>Lancer</strong> déclenche une tâche à la main, comme si le
  planificateur s'était réveillé : grâce court-circuitée, échéance clôturée,
  suivante inscrite, rapport consigné — et affiché aussitôt sous le tableau
  (spec 037). Coup unique, sans réessai : un échec se lit là, et on relance à la
  main. Le battement n'en a pas, car son absence est précisément ce qu'il
  annonce.
</p>

<%
  const JOURS = { 1: "lundi", 2: "mardi", 3: "mercredi", 4: "jeudi",
                  5: "vendredi", 6: "samedi", 7: "dimanche" };
  const cadenceLisible = (cadence) => {
    const heure = `${String(cadence.heure).padStart(2, "0")} h ${String(cadence.minute).padStart(2, "0")}`;
    if (cadence.nature === "ponctuelle") return "au fil de l'eau";
    if (cadence.nature === "quotidienne") return `chaque jour à ${heure}`;
    return `chaque ${JOURS[cadence.jour]} à ${heure}`;
  };
%>

<table>
  <tr>
    <th>Tâche</th><th>Cadence</th><th>Grâce</th>
    <th>Prochaine échéance</th><th>Tentatives</th><th>Dernière issue</th>
    <th>Action</th>
  </tr>
  <% for (const tache of taches) { %>
    <tr>
      <td><%= tache.intitule %></td>
      <td>
        <%= cadenceLisible(tache.reglage.cadence) %><%= tache.reglage.active ? "" : " (suspendue)" %>
      </td>
      <td><%= tache.reglage.graceMinutes %> min</td>
      <td>
        <%= tache.prochaine ? tache.prochaine.prevueLe.toLocaleString("fr-FR") : "aucune" %>
      </td>
      <td><%= tache.prochaine ? tache.prochaine.tentatives : "—" %></td>
      <td>
        <% if (tache.dernierRapport) { %>
          <%= tache.dernierRapport.issue %>,
          le <%= tache.dernierRapport.demarreLe.toLocaleString("fr-FR") %>
        <% } else { %>
          jamais exécutée
        <% } %>
      </td>
      <td>
        <%# Règle uniforme, une exception : toute tâche active à cadence porte %>
        <%# un bouton Lancer, sauf le battement dont le silence est exactement %>
        <%# l'information qu'il préserve (037, 019). Les ponctuelles ne sont %>
        <%# pas des passes (014). %>
        <% if (tache.reglage.active && tache.reglage.cadence.nature !== "ponctuelle" && tache.tache !== battement) { %>
          <form method="post" action="/sources/ordonnancement/<%= tache.tache %>/executer">
            <button type="submit">Lancer</button>
          </form>
        <% } else { %>
          —
        <% } %>
      </td>
    </tr>
  <% } %>
</table>

<%# Le rapport du dernier déclenchement, juste sous le tableau : c'est là %>
<%# qu'on a cliqué, et c'est le verdict qu'on cherche immédiatement (037). %>
<% if (declenchement) { %>
  <h3>Dernier déclenchement</h3>
  <%- include("rapport-de-passe", { passe: declenchement }) %>
<% } %>

<% for (const tache of taches) { %>
  <form method="post" action="/sources/ordonnancement">
    <input type="hidden" name="tache" value="<%= tache.tache %>">
    <p>
      <strong><%= tache.intitule %></strong><br>
      <label for="nature-<%= tache.tache %>">Cadence</label>
      <select id="nature-<%= tache.tache %>" name="nature">
        <% for (const nature of ["quotidienne", "hebdomadaire", "ponctuelle"]) { %>
          <option value="<%= nature %>"
                  <%= tache.reglage.cadence.nature === nature ? "selected" : "" %>>
            <%= nature %>
          </option>
        <% } %>
      </select>
      <label for="jour-<%= tache.tache %>">jour</label>
      <select id="jour-<%= tache.tache %>" name="jour">
        <% for (const numero of [1, 2, 3, 4, 5, 6, 7]) { %>
          <option value="<%= numero %>"
                  <%= tache.reglage.cadence.jour === numero ? "selected" : "" %>>
            <%= JOURS[numero] %>
          </option>
        <% } %>
      </select>
      <label for="heure-<%= tache.tache %>">à</label>
      <input id="heure-<%= tache.tache %>" name="heure" type="number" min="0" max="23" size="2"
             value="<%= tache.reglage.cadence.heure ?? 0 %>"> h
      <input name="minute" type="number" min="0" max="59" size="2"
             aria-label="minute" value="<%= tache.reglage.cadence.minute ?? 0 %>">
      <label for="grace-<%= tache.tache %>">grâce</label>
      <input id="grace-<%= tache.tache %>" name="grace" type="number" min="0" size="4"
             value="<%= tache.reglage.graceMinutes %>"> min
      <label for="active-<%= tache.tache %>">active</label>
      <input id="active-<%= tache.tache %>" name="active" type="checkbox"
             <%= tache.reglage.active ? "checked" : "" %>>
      <button type="submit">Régler</button>
    </p>
  </form>
<% } %>

<h2>Déploiements</h2>
<p>
  myffbad se lit par des fonctions serveur désignées par un identifiant calculé
  à sa construction : un redéploiement peut les périmer. Chaque réponse annonce
  son build ; les compter dit à quelle fréquence il faudra les relever
  (spec 015).
</p>

<table>
  <tr><th>Source</th><th>Build courant</th><th>Vu depuis</th><th>Builds observés</th></tr>
  <% for (const deploiement of deploiements) { %>
    <tr>
      <td><%= deploiement.source %></td>
      <td><%= deploiement.build ?? "—" %></td>
      <td><%= deploiement.depuis ? deploiement.depuis.toLocaleString("fr-FR") : "—" %></td>
      <td><%= deploiement.builds %></td>
    </tr>
  <% } %>
</table>

<% for (const deploiement of deploiements.filter((d) => d.actionsPeutEtrePerimees)) { %>
  <p class="etat">
    <strong><%= deploiement.source %> a redéployé</strong> depuis le relevé des
    identifiants d'action. Ils peuvent avoir péri — seul le redéploiement de
    l'action elle-même les invalide, donc rien n'est sûr. La panne, si elle
    vient, sera franche : « action introuvable », jamais une liste vide.
  </p>
<% } %>

<h2>Exécutions</h2>
<p>
  Toute exécution automatique laisse une trace, <strong>succès compris</strong>
  (spec 019). C'est la seule façon de distinguer une semaine sans incident d'un
  planificateur arrêté — un mail ne part qu'à l'entrée en panne, donc le silence
  du courrier ne prouve rien à lui seul.
</p>
<p>
  L'issue <code>vide</code> n'est pas un demi-succès : c'est une panne, celle
  que 019 vise en premier. La page a répondu, le parseur s'est exécuté sans rien
  lever, et il n'a rien extrait — une classe CSS a changé. Une exception se
  voit ; un parseur devenu aveugle ne se voit pas.
</p>

<% if (rapports.length === 0) { %>
  <p class="etat">Aucune exécution consignée.</p>
<% } else { %>
  <table>
    <tr>
      <th>Démarrée</th><th>Tâche</th><th>Issue</th><th>Extraits</th>
      <th>Durée</th><th>Détail</th>
    </tr>
    <% for (const rapport of rapports) { %>
      <tr>
        <td><%= rapport.demarreLe.toLocaleString("fr-FR") %></td>
        <td><%= rapport.tache %></td>
        <td>
          <% if (rapport.issue === "succes") { %>
            succès
          <% } else { %>
            <strong><%= rapport.issue === "vide" ? "extraction vide" : "échec" %></strong>
          <% } %>
        </td>
        <td><%= rapport.volumeExtrait ?? "—" %></td>
        <td>
          <%= Math.round((rapport.termineLe.getTime() - rapport.demarreLe.getTime()) / 1000) %> s
        </td>
        <td><%= rapport.detail ?? "" %></td>
      </tr>
    <% } %>
  </table>
  <p class="etat">
    Les cinquante dernières. Rien n'est purgé : une ligne de rapport pèse
    quelques dizaines d'octets, et le battement hebdomadaire annonce la taille
    de la base — si la croissance devient un problème, la mesure le dira avant
    que l'estimation ne le devine.
  </p>
<% } %>

<h2>Courrier</h2>
<p>
  Les mails que Babo envoie : les alertes de panne et le battement de 019, les
  alertes de tournoi de 013, les rappels de 014 (spec 016). Le SMTP est celui
  d'un compte Gmail, et le seul destinataire est moi — 008 a retiré les mails
  des coéquipiers, il n'y a personne d'autre à qui écrire.
</p>
<p>
  <strong>Tout message est écrit en base avant d'être remis</strong>, puis
  envoyé aussitôt. Un envoi qui échoue est repris à cinq puis à trente minutes,
  et abandonné à la troisième tentative. Un échec d'envoi ne peut pas être
  signalé par mail : il se lit ici, et dans les rapports d'exécution.
</p>

<p class="etat">
  <% if (courrier.configure) { %>
    Courrier configuré, à destination de <strong><%= courrier.destinataire %></strong>.
  <% } else { %>
    <strong>Courrier non configuré</strong> : les messages sont écrits en base
    et personne ne les remet. Renseigner <code>BABO_SMTP_UTILISATEUR</code>,
    <code>BABO_SMTP_MOT_DE_PASSE</code>, <code>BABO_MAIL_EXPEDITEUR</code> et
    <code>BABO_MAIL_DESTINATAIRE</code> — voir <code>.env.example</code>. Le mot
    de passe est un <em>mot de passe d'application</em> Google, jamais celui du
    compte.
  <% } %>
  <%= courrier.enAttente %> message<%= courrier.enAttente > 1 ? "s" : "" %> en attente.
</p>

<form method="post" action="/sources/courrier"><button type="submit">Envoyer un mail de test</button></form>

<% if (mailDeTest) { %>
  <p class="etat">
    Mail de test <strong><%= { "en-attente": "en attente", envoye: "remis", abandonne: "abandonné" }[mailDeTest.etat] %></strong>,
    déposé le <%= mailDeTest.deposeLe.toLocaleString("fr-FR") %>.
    <% if (mailDeTest.dernierEchec) { %>
      <br><%= mailDeTest.dernierEchec %>
    <% } %>
  </p>
<% } %>

<% if (courrier.derniers.length > 0) { %>
  <table>
    <tr><th>Déposé le</th><th>Sujet</th><th>État</th><th>Tentatives</th><th>Dernier échec</th></tr>
    <% for (const message of courrier.derniers) { %>
      <tr>
        <td><%= message.deposeLe.toLocaleString("fr-FR") %></td>
        <td><%= message.sujet %></td>
        <td>
          <%= { "en-attente": "en attente", envoye: "remis", abandonne: "abandonné" }[message.etat] %>
        </td>
        <td><%= message.tentatives %></td>
        <td><%= message.dernierEchec ?? "—" %></td>
      </tr>
    <% } %>
  </table>
<% } %>

<h2>Sonder l'accès</h2>
<p>
  La sonde joue les requêtes qui portent les données, les archive telles
  quelles, et compte ce qu'elle en tire. C'est le décompte qui vaut, pas la
  taille : une session morte rend un statut 200 et une liste vide, et seule la
  colonne « extraits » l'en distingue (specs 015 et 019).
</p>
<form method="post" action="/sources/sonde"><button type="submit">Sonder</button></form>

<% if (sonde) { %>
  <table>
    <tr>
      <th>Source</th><th>Page</th><th>Verdict</th><th>Statut</th>
      <th>Extraits</th><th>Taille</th><th>Détail</th>
    </tr>
    <% for (const resultat of sonde) { %>
      <tr>
        <td><%= resultat.source %></td>
        <td><%= resultat.page.intitule %></td>
        <td><%= resultat.verdict %></td>
        <td><%= resultat.statutHttp ?? "—" %></td>
        <td><%= resultat.extraits ?? "—" %></td>
        <td><%= resultat.octets === null ? "—" : Math.round(resultat.octets / 1024) + " Ko" %></td>
        <td><%= resultat.detail ?? "" %></td>
      </tr>
    <% } %>
  </table>
<% } %>

<h2>Importer l'équipe</h2>
<p>
  La liste des membres de l'équipe, telle que <a href="/capitanat">Capitanat</a>
  l'affiche (spec 005). Trois colonnes,
  <code>licence;sexe;telephone</code>, l'en-tête est obligatoire, le séparateur
  est le point-virgule seul et le fichier doit être en <strong>UTF-8</strong> —
  « CSV UTF-8 » dans le tableur. Le sexe est <code>F</code> ou <code>M</code> ;
  le téléphone est gardé tel qu'il est écrit. Ma propre licence y figure comme
  les autres.
</p>
<p>
  <strong>L'import remplace la liste entière</strong> : un coéquipier absent du
  fichier est supprimé, avec ses relevés de classement. Et c'est tout ou rien —
  une seule ligne fautive et rien n'est écrit, chaque anomalie étant rendue avec
  son numéro de ligne. Le fichier n'est pas déposé sur le serveur : seul son
  contenu est envoyé.
</p>
<p>
  Un import réussi enchaîne aussitôt une passe : on dépose huit lignes, on lit
  huit noms. C'est ce qui rend visible une licence bien formée mais erronée —
  elle rapporte le nom de quelqu'un d'autre, et seul le nom affiché le dit.
</p>

<form id="import-equipe">
  <p>
    <label for="fichier-equipe">Fichier CSV</label><br>
    <input id="fichier-equipe" type="file" accept=".csv,text/csv" required>
  </p>
  <button type="submit">Importer l'équipe</button>
</form>

<script>
  // Dix lignes de JS plutôt que `multer` : Express ne lit pas le multipart, et
  // le lire ici évite qu'un fichier de coordonnées atterrisse sur le disque.
  // `file.text()` décode en UTF-8 sans deviner : un fichier Latin-1 arrive
  // avec ses caractères de remplacement, que le serveur refuse en le disant.
  document.getElementById("import-equipe").addEventListener("submit", async (evenement) => {
    evenement.preventDefault();
    const fichier = document.getElementById("fichier-equipe").files[0];
    if (fichier === undefined) return;
    const reponse = await fetch("/sources/equipe", {
      method: "POST",
      headers: { "content-type": "text/csv; charset=utf-8" },
      body: await fichier.text(),
    });
    document.open();
    document.write(await reponse.text());
    document.close();
  });
</script>

<% if (equipe) { %>
  <% if (equipe.issue === "importee") { %>
    <p class="etat">
      Équipe remplacée : <strong><%= equipe.membres %></strong>
      membre<%= equipe.membres > 1 ? "s" : "" %> importé<%= equipe.membres > 1 ? "s" : "" %>.
      La liste est sur <a href="/capitanat">Capitanat</a>.
    </p>

    <%# La passe suit l'import (028) : c'est ce qui rend une licence bien %>
    <%# formée mais erronée visible tout de suite, par le nom affiché. %>
    <% if (equipe.releve) { %>
      <%- include("rapport-de-passe", { passe: equipe.releve }) %>
    <% } %>
  <% } else { %>
    <p class="etat">
      <strong>Import refusé, rien n'a été écrit.</strong> L'équipe en base est
      inchangée.
    </p>
    <table>
      <tr><th>Ligne</th><th>Raison</th></tr>
      <% for (const motif of equipe.motifs) { %>
        <tr>
          <td><%= motif.ligne ?? "—" %></td>
          <td><%= motif.raison %></td>
        </tr>
      <% } %>
    </table>
  <% } %>
<% } %>

<h2>Mes engagements</h2>
<p>
  Mes inscriptions de tournoi, relevées sur badnet sous session (spec 027) :
  tournoi, date, tableaux engagés et partenaire. Le planificateur lance cette
  passe chaque matin à 5 h ; la relancer se fait sur le tableau
  d'ordonnancement, colonne <strong>Lancer</strong> (spec 037).
</p>
<p>
  <strong>Elle coûte cher en requêtes</strong>, et c'est assumé : badnet sert
  toutes ses pages en coquille, donc deux requêtes pour la liste et trois par
  fiche, aucun identifiant d'action n'étant écrit en dur. C'est ce qui évite
  qu'un redéploiement de badnet fasse tomber la passe sans prévenir.
</p>
<p class="etat">
  <% if (engagementsEnBase === 0) { %>
    Aucun engagement en base. En intersaison c'est normal : la passe le consigne
    comme un succès à zéro plutôt que comme une extraction vide, parce qu'on ne
    s'engage pas toute l'année (spec 019).
  <% } else { %>
    <strong><%= engagementsEnBase %></strong> engagement<%= engagementsEnBase > 1 ? "s" : "" %>
    en base. La liste se lit sur <a href="/mon-profil">mon profil</a> : cet
    écran porte l'exploitation, la feature porte la donnée (spec 002).
  <% } %>
</p>

<% if (connexion) { %>
  <p class="etat">
    <% if (connexion.issue === "ouverte") { %>
      <strong>Session <%= connexion.source %> ouverte.</strong> Aucun code n'a
      été demandé — la double authentification ne s'est pas déclenchée. Son
      échéance se lit dans le bloc « Enregistrer une session » ci-dessous ;
      faute d'une date portée par le jeton, elle est devinée à un mois, et
      c'est la date d'obtention qui dira la vraie durée.
    <% } else { %>
      Un code de vérification a été demandé à
      <strong><%= connexion.source %></strong>. Il arrive par mail : le
      recopier dans le champ ci-dessous.
    <% } %>
  </p>
<% } %>

<h2>Enregistrer une session</h2>
<p>
  Babo ne renouvelle aucune session : il garde celle que tu lui donnes. Se
  connecter dans un navigateur, y copier le cookie de session, le coller ici.
  Pour badnet c'est incontournable — une 2FA garde la porte ; pour myffbad,
  qui n'en a pas, c'est provisoire (spec 015). Babo ne demande jamais le mot de passe fédéral, et le jeton
  est écrit dans la base chiffrée, jamais dans un journal — c'est pourquoi le
  champ reste vide même quand une session existe : Babo ne réaffiche jamais un
  jeton qu'on lui a confié. Ce qu'il en dit se lit juste au-dessus du champ.
  L'échéance affichée est celle que porte le jeton, quand il la porte.
</p>

<% for (const etat of etats) { %>
  <h3><%= etat.source %></h3>

  <p class="etat">
    <% if (etat.session === "absente") { %>
      Aucune session enregistrée pour cette source.
    <% } else if (etat.session === "expiree") { %>
      Session enregistrée le <%= etat.enregistreeLe.toLocaleString("fr-FR") %>,
      <strong>expirée</strong> depuis le <%= etat.expireLe.toLocaleString("fr-FR") %>.
      En enregistrer une nouvelle.
    <% } else { %>
      Session enregistrée le <%= etat.enregistreeLe.toLocaleString("fr-FR") %>,
      valide jusqu'au <%= etat.expireLe.toLocaleString("fr-FR") %>
      (<%= etat.joursRestants %> jour<%= etat.joursRestants > 1 ? "s" : "" %>).
    <% } %>
  </p>

  <%
    // Un code attendu pour cette source : l'écran bascule sur le second temps.
    // C'est cette bascule qui distingue « le code n'est pas encore parti » de
    // « le code est faux » (spec 027).
    const attendu = codesAttendus.find((attente) => attente.source === etat.source);
  %>

  <% if (attendu) { %>
    <form method="post" action="/sources/<%= etat.source %>/code">
      <p class="etat">
        <strong>Code demandé</strong> le
        <%= attendu.demandeeLe.toLocaleTimeString("fr-FR") %>. badnet l'envoie
        par mail. L'attente tombe au bout de dix minutes : passé ce délai, il
        faut en redemander un plutôt que de saisir un code périmé.
      </p>
      <p>
        <label for="code-<%= etat.source %>">Code reçu par mail</label>
        <input id="code-<%= etat.source %>" name="code" size="12" autocomplete="one-time-code" required>
        <button type="submit">Valider le code</button>
      </p>
    </form>
  <% } else if (etat.autonome) { %>
    <form method="post" action="/sources/<%= etat.source %>/connexion">
      <p>
        Cette source sait aller chercher sa session : son mot de passe est
        configuré. myffbad aboutit d'un coup ; badnet a une double
        authentification et demandera un code reçu par mail (specs 015 et 027).
      </p>
      <button type="submit">Se connecter maintenant</button>
    </form>
  <% } %>

  <form method="post" action="/sources/<%= etat.source %>/jeton">
    <p>
      <label for="valeur-<%= etat.source %>">
        <%= etat.autonome ? "Ou coller un cookie à la main" :
            etat.session === "absente" ? "Cookie de session" : "Remplacer par" %>
      </label><br>
      <input id="valeur-<%= etat.source %>" name="valeur" size="60"
             placeholder="nom=valeur; autre=valeur" required>
    </p>
    <button type="submit">Enregistrer la session</button>
  </form>

  <% if (etat.session !== "absente") { %>
    <form method="post" action="/sources/<%= etat.source %>/oubli">
      <button type="submit">Oublier cette session</button>
    </form>
  <% } %>
<% } %>

<%- include("pied") %>
