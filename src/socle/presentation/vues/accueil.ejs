<%- include("entete", { titre }) %>

<% if (pannes.length > 0) { %>
  <div class="etat attention">
    <strong>Une source demande un geste.</strong>
    <ul>
      <% for (const panne of pannes) { %><li><%= panne %></li><% } %>
    </ul>
    Le détail et de quoi réparer sont dans <a href="/parametres">les paramètres</a>.
  </div>
<% } %>

<div class="tuiles">
  <% for (const tuile of tuiles) { %>
    <section class="tuile">
      <h2><a href="<%= tuile.chemin %>"><%= tuile.intitule %></a></h2>
      <%- include(tuile.vue, tuile.donnees) %>
    </section>
  <% } %>
</div>

<p class="discret">
  <% if (pannes.length === 0) { %>Sources en ordre · <% } %>base de
  <%= Math.round(socle.tailleDeLaBase / 1024).toLocaleString("fr-FR") %> Ko ·
  <%= socle.captures.toLocaleString("fr-FR") %> captures archivées
</p>

<%- include("pied") %>
