<h3>Sonder l'accès
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Joue les requêtes qui portent les données et compte ce qu'elle en tire. C'est la colonne
      « extraits » qui vaut : une session morte rend un statut 200 et une liste vide.</span>
  </span></span>
</h3>
<form method="post" action="/parametres/scrapping/sondes"><button type="submit">Sonder</button></form>

<% if (sonde) { %>
  <table>
    <tr>
      <th>Source</th><th>Page</th><th>Verdict</th><th>Statut</th>
      <th>Extraits</th><th>Taille</th><th>Détail</th>
    </tr>
    <% for (const resultat of sonde) { %>
      <tr>
        <td><%= resultat.source %></td>
        <td><%= resultat.page.intitule %></td>
        <td><%= resultat.verdict %></td>
        <td><%= resultat.statutHttp ?? "—" %></td>
        <td><%= resultat.extraits ?? "—" %></td>
        <td><%= resultat.octets === null ? "—" : Math.round(resultat.octets / 1024) + " Ko" %></td>
        <td><%= resultat.detail ?? "" %></td>
      </tr>
    <% } %>
  </table>
<% } %>
