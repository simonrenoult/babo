<h3>Déploiements
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Un redéploiement de myffbad peut périmer les identifiants des fonctions qu'on appelle.
      Compter les builds dit à quelle fréquence il faudra les relever.</span>
  </span></span>
</h3>

<table>
  <tr><th>Source</th><th>Build courant</th><th>Vu depuis</th><th>Builds observés</th></tr>
  <% for (const deploiement of deploiements) { %>
    <tr>
      <td><%= deploiement.source %></td>
      <td><%= deploiement.build ?? "—" %></td>
      <td><%= deploiement.depuis ? deploiement.depuis.toLocaleString("fr-FR") : "—" %></td>
      <td><%= deploiement.builds %></td>
    </tr>
  <% } %>
</table>

<% for (const deploiement of deploiements.filter((d) => d.actionsPeutEtrePerimees)) { %>
  <p class="etat attention">
    <strong><%= deploiement.source %> a redéployé</strong> depuis le relevé des
    identifiants d'action : ils ont peut-être péri. Si c'est le cas, la panne
    sera franche — « action introuvable », jamais une liste vide.
  </p>
<% } %>
