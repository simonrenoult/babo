<%#
  Le courrier, sur la page de la tâche qui vide la boîte d'envoi : sa
  configuration, le mail de test, et les derniers messages.
%>
<h4>Courrier
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Alertes de panne, battement hebdomadaire, alertes et rappels de tournoi. Un seul
      destinataire : moi.</span>
    <span><strong>Tout message est écrit en base avant d'être remis</strong>, puis envoyé aussitôt
      par le SMTP d'un compte Gmail. Un envoi qui échoue est repris à cinq puis à trente
      minutes, et abandonné à la troisième tentative. Un échec d'envoi ne peut pas être
      signalé par mail : il se lit ici, et dans les rapports d'exécution.</span>
  </span></span>
</h4>
<div class="barre-actions">
  <form method="post" action="/parametres/scrapping/ordonnancement/courrier/mail-de-test">
    <button type="submit">Envoyer un mail de test</button>
  </form>
</div>

<% if (mailDeTest) { %>
  <p class="etat">
    Mail de test <strong><%= { "en-attente": "en attente", envoye: "remis", abandonne: "abandonné" }[mailDeTest.etat] %></strong>,
    déposé le <%= mailDeTest.deposeLe.toLocaleString("fr-FR") %>.
    <% if (mailDeTest.dernierEchec) { %>
      <br><%= mailDeTest.dernierEchec %>
    <% } %>
  </p>
<% } %>

<p class="etat <%= courrier.configure ? "" : "attention" %>">
  <% if (courrier.configure) { %>
    Courrier configuré, à destination de <strong><%= courrier.destinataire %></strong>.
  <% } else { %>
    <strong>Courrier non configuré</strong> : les messages sont écrits en base
    et personne ne les remet. Renseigner <code>BABO_SMTP_UTILISATEUR</code>,
    <code>BABO_SMTP_MOT_DE_PASSE</code>, <code>BABO_MAIL_EXPEDITEUR</code> et
    <code>BABO_MAIL_DESTINATAIRE</code> — voir <code>.env.example</code>. Le mot
    de passe est un <em>mot de passe d'application</em> Google, jamais celui du
    compte.
  <% } %>
  <%= courrier.enAttente %> message<%= courrier.enAttente > 1 ? "s" : "" %> en attente.
</p>

<% if (courrier.derniers.length > 0) { %>
  <h4>Derniers messages</h4>
  <table>
    <tr><th>Déposé le</th><th>Sujet</th><th>État</th><th>Tentatives</th><th>Dernier échec</th></tr>
    <% for (const message of courrier.derniers) { %>
      <tr>
        <td><%= message.deposeLe.toLocaleString("fr-FR") %></td>
        <td><%= message.sujet %></td>
        <td>
          <% const [ton, libelle] = { "en-attente": ["attention", "en attente"], envoye: ["succes", "remis"], abandonne: ["erreur", "abandonné"] }[message.etat]; %>
          <span class="pastille <%= ton %>"><%= libelle %></span>
        </td>
        <td><%= message.tentatives %></td>
        <td><%= message.dernierEchec ?? "—" %></td>
      </tr>
    <% } %>
  </table>
<% } %>
