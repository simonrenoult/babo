<h3>Exécutions
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Les cinquante dernières.</span>
    <span>Toute exécution automatique laisse une trace, succès compris. Une <strong>extraction
      vide</strong> est une panne : la page a répondu, mais le parseur n'en a rien tiré.</span>
  </span></span>
</h3>

<% if (rapports.length === 0) { %>
  <p class="etat">Aucune exécution consignée.</p>
<% } else { %>
  <table>
    <tr>
      <th>Démarrée</th><th>Tâche</th><th>Issue</th><th>Extraits</th>
      <th>Durée</th><th>Détail</th>
    </tr>
    <% for (const rapport of rapports) { %>
      <tr>
        <td><%= rapport.demarreLe.toLocaleString("fr-FR") %></td>
        <td><%= rapport.tache %></td>
        <td>
          <%- include("../issue", { issue: rapport.issue }) %>
        </td>
        <td><%= rapport.volumeExtrait ?? "—" %></td>
        <td>
          <%= Math.round((rapport.termineLe.getTime() - rapport.demarreLe.getTime()) / 1000) %> s
        </td>
        <td><%= rapport.detail ?? "" %></td>
      </tr>
    <% } %>
  </table>
<% } %>
