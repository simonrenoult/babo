<%# Le résultat d'une sonde, une ligne par page. Paramètre : `sonde`, ou `null`. %>
<% if (sonde) { %>
  <table>
    <tr>
      <th>Source</th><th>Page</th><th>Verdict</th><th>Statut</th>
      <th>Extraits</th><th>Taille</th><th>Détail</th>
    </tr>
    <% for (const resultat of sonde) { %>
      <tr>
        <td><%= resultat.source %></td>
        <td><%= resultat.page.intitule %></td>
        <td>
          <% const [ton, libelle] = { atteinte: ["succes", "atteinte"], "mur-de-connexion": ["erreur", "mur de connexion"], "action-introuvable": ["erreur", "action introuvable"], echec: ["erreur", "échec"] }[resultat.verdict] ?? ["", resultat.verdict]; %>
          <span class="pastille <%= ton %>"><%= libelle %></span>
        </td>
        <td><%= resultat.statutHttp ?? "—" %></td>
        <td><%= resultat.extraits ?? "—" %></td>
        <td><%= resultat.octets === null ? "—" : Math.round(resultat.octets / 1024) + " Ko" %></td>
        <td><%= resultat.detail ?? "" %></td>
      </tr>
    <% } %>
  </table>
<% } %>
