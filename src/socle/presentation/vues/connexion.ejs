<%- include("entete", { titre, nu: true }) %>

<h2>Connexion
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Service personnel : rien n'y répond sans mot de passe.</span>
    <span>La session dure 30 jours et se prolonge à chaque visite, dans la limite de 90 jours.</span>
  </span></span>
</h2>

<% if (erreur) { %>
  <p class="etat erreur"><strong><%= erreur %></strong></p>
<% } else if (motif) { %>
  <p class="etat"><%= motif %></p>
<% } %>

<form method="post" action="/connexion">
  <% if (suite) { %>
    <input type="hidden" name="suite" value="<%= suite %>">
  <% } %>
  <p>
    <label for="licence">Numéro de licence</label><br>
    <input id="licence" name="licence" inputmode="numeric" autocomplete="username"
           size="20" autofocus required>
  </p>
  <p>
    <label for="motDePasse">Mot de passe</label><br>
    <input id="motDePasse" name="motDePasse" type="password"
           autocomplete="current-password" size="30" required>
  </p>
  <button type="submit" class="principal">Entrer</button>
</form>


<%- include("pied") %>
