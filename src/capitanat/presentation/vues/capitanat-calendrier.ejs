<%- include("entete", { titre }) %>
<h2><%= titre %></h2>
<%- include("capitanat-onglets") %>

<% if (calendrier === null) { %>
  <p class="etat">
    Aucun calendrier importé. Il se lit sur icbad, depuis
    <a href="/parametres/calendrier">l'écran des paramètres</a> : la page du
    groupe et le code de l'équipe suffisent.
  </p>
<% } else { %>
  <div class="barre-actions">
    <a class="bouton" href="/capitanat/calendrier.ics" download>Exporter le calendrier (.ics)</a>
    <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
      <span>Toute la saison, pour un agenda. Dans Google Agenda : Paramètres › Importer et
        exporter › Importer, puis choisir ce fichier.</span>
      <span>Réimporter après un changement met les rencontres à jour sans les doubler. Chaque
        rencontre compte deux heures et demie : icbad ne publie que l'heure de début.</span>
      <span>Pour une seule rencontre, le lien <strong>Google Agenda</strong> de sa ligne.</span>
    </span></span>
  </div>

  <p>
    <strong><%= calendrier.equipe.nom %></strong>, <%= calendrier.competition %>,
    <%= calendrier.groupe %>.
  </p>
  <p class="discret">
    Importé le <%= calendrier.importeLe.toLocaleDateString("fr-FR") %> depuis
    <a href="<%= calendrier.url %>" rel="noreferrer noopener" target="_blank">icbad</a>.
    <a href="/parametres/calendrier">Réimporter</a> si le comité déplace une rencontre.
  </p>

  <table>
    <tr>
      <th>Journée</th><th>Date</th><th>Heure</th><th></th><th>Adversaire</th><th>Lieu</th><th>Agenda</th>
    </tr>
    <% for (const rencontre of calendrier.rencontres) { %>
      <%# Une rencontre passée reste listée, estompée : la saison se lit d'un bloc. %>
      <tr<%- rencontre.debut < maintenant ? ' style="opacity: .55"' : "" %>>
        <td>
          <a href="https://icbad.ffbad.org/rencontre/<%= rencontre.id %>"
             rel="noreferrer noopener" target="_blank">J<%= String(rencontre.journee).padStart(2, "0") %></a>
        </td>
        <td data-tri="<%= rencontre.debut.getTime() %>"><%= rencontre.debut.toLocaleDateString("fr-FR", { weekday: "short", day: "numeric", month: "short", year: "numeric" }) %></td>
        <td><%= heure(rencontre.debut) %></td>
        <td><%= recoitOn(rencontre, calendrier.equipe) ? "reçoit" : "se déplace" %></td>
        <% const adversaire = adversaireDe(rencontre, calendrier.equipe); %>
        <td><abbr title="<%= adversaire.nom %>"><%= sigleDe(adversaire) %></abbr></td>
        <td>
          <%# L'API « search » de Google Maps : une URL stable, sans clé, qui ouvre %>
          <%# l'application sur téléphone. Le lieu est encodé, jamais recollé tel quel. %>
          <a href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(rencontre.lieu) %>"
             rel="noreferrer noopener" target="_blank"><%= rencontre.lieu %></a>
        </td>
        <td>
          <a href="<%= lienGoogle(rencontre, calendrier) %>" rel="noreferrer noopener" target="_blank">Google Agenda</a>
        </td>
      </tr>
    <% } %>
  </table>
<% } %>

<%- include("pied") %>
