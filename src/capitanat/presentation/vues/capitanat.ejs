<%- include("entete", { titre }) %>
<h2><%= titre %></h2>

<% if (equipe.length === 0) { %>
  <h3>Mon équipe</h3>
  <p class="etat">
    Aucune équipe importée. Le fichier se dépose depuis
    <a href="/parametres/equipe">l'écran des paramètres</a> : une ligne par joueur,
    <code>licence;sexe;telephone</code>, en-tête comprise, en UTF-8.
  </p>
<% } else { %>
  <%- include("peremption", { fraicheur }) %>

  <h3>Les cinq tableaux</h3>

  <p>
    Une rencontre se joue en <strong>six matchs répartis sur cinq tableaux</strong> :
    deux simples hommes, un simple dames, un double hommes, un double dames, un
    mixte. Chaque tableau a sa page, qui range les joueurs éligibles du plus fort
    au plus faible (spec 029), porte les paires du double et du mixte, et fait
    remonter en tête ce que je privilégie (spec 030).
  </p>

  <p class="etat">
    <% if (paires === 0) { %>
      Aucune paire saisie. Elles se saisissent sur la page du double hommes, du
      double dames ou du mixte : une paire n'a pas de classement fédéral, et son
      ordre est la moyenne des deux cotes.
    <% } else { %>
      <%= paires %> paire<%= paires > 1 ? "s" : "" %> saisie<%= paires > 1 ? "s" : "" %>,
      réparties sur les pages du double hommes, du double dames et du mixte.
    <% } %>
  </p>

  <%
    // Nommer les tableaux en manque, pas les compter : c'est la question que se
    // pose un capitaine avant une journée, et la seule que cet index tranche.
    const infaisables = forces.filter((force) => force.manques.length > 0);
  %>

  <% if (infaisables.length === 0) { %>
    <p class="etat">L'effectif permet de remplir les cinq tableaux.</p>
  <% } else { %>
    <p class="etat">
      <%= infaisables.length %> tableau<%= infaisables.length > 1 ? "x" : "" %>
      que l'effectif ne permet pas de remplir :
      <%= infaisables
            .map((force) => `${force.intitule} (il manque ${joueursRequis(force.manques, force.discipline)})`)
            .join(", ") %>.
    </p>
  <% } %>

  <table>
    <tr>
      <th>Tableau</th><th>Matchs</th><th>Il faut</th><th>Alignables</th><th>Manque</th>
    </tr>
    <% for (const force of forces) { %>
      <tr>
        <td>
          <a href="/capitanat/tableau/<%= force.tableau %>"><%= force.intitule %></a>
          <span class="etat"><%= force.tableau %></span>
        </td>
        <td><%= force.matchs %></td>
        <td><%= joueursRequis(force.places, force.discipline) %></td>
        <td><%= force.alignables.length %></td>
        <td><%= force.manques.length === 0 ? "—" : enJoueurs(force.manques) %></td>
      </tr>
    <% } %>
  </table>

  <p>
    <strong>Les cinq listes ne se cumulent pas.</strong> Un joueur figure dans
    tous les tableaux où il est éligible, et ne fera pourtant pas les six matchs :
    les additionner surestimerait la profondeur de l'effectif. Le plafond de
    matchs par joueur viendra avec la composition de journée (spec 011).
  </p>

  <h3>Mon équipe</h3>

  <%
    // Une case vide ne doit jamais pouvoir se lire comme « non classé » : tant
    // qu'aucune passe n'a abouti, on le dit en toutes lettres (028, dans
    // l'esprit de 001 qui refuse le tableau de tirets).
    const releves = equipe.filter((membre) => membre.nom !== null).length;
  %>

  <p>
    <%= equipe.length %> membre<%= equipe.length > 1 ? "s" : "" %>, moi compris.
    Le sexe et le téléphone viennent du fichier ; le nom et le classement sont
    relevés sur myffbad chaque vendredi (spec 028). L'import remplace la liste
    entière.
  </p>

  <% if (releves === 0) { %>
    <p class="etat">
      Noms et classements non encore relevés. La passe se lance depuis
      <a href="/parametres/scrapping/ordonnancement">l'écran des paramètres</a>.
    </p>
  <% } else if (releves < equipe.length) { %>
    <p class="etat">
      <%= equipe.length - releves %> membre<%= equipe.length - releves > 1 ? "s" : "" %>
      sans relevé : la dernière passe ne les a pas trouvés sur myffbad. Le
      rapport en donne la raison sur <a href="/parametres/scrapping/logs">l'écran des paramètres</a>.
    </p>
  <% } %>

  <table>
    <tr>
      <th>Nom</th><th>Licence</th><th>Sexe</th>
      <th>Simple</th><th>Double</th><th>Mixte</th>
      <th>Relevé le</th><th>Téléphone</th><th>Fiche</th>
    </tr>
    <% for (const membre of equipe) { %>
      <%
        const parDiscipline = new Map(
          membre.classements.map((classement) => [classement.discipline, classement]),
        );
      %>
      <tr>
        <td><%= membre.nom ?? "—" %></td>
        <td><%= membre.licence %></td>
        <td><%= membre.sexe %></td>
        <% for (const discipline of ["simple", "double", "mixte"]) { %>
          <% const classement = parDiscipline.get(discipline); %>
          <td>
            <% if (classement === undefined) { %>
              <span class="etat"><%= membre.nom === null ? "non relevé" : "non joué" %></span>
            <% } else { %>
              <%= classement.lettre %>
              <span class="etat"><%= classement.cpph.toLocaleString("fr-FR") %></span>
            <% } %>
          </td>
        <% } %>
        <td><%= membre.vuLe === null ? "—" : membre.vuLe.toLocaleDateString("fr-FR") %></td>
        <td><a href="tel:<%= membre.appel %>"><%= membre.telephone %></a></td>
        <td>
          <a href="<%= membre.fiche %>" rel="noreferrer noopener" target="_blank">myffbad</a>
        </td>
      </tr>
    <% } %>
  </table>
<% } %>

<h3>Ce qui viendra ici</h3>
<ul>
  <li>Performance individuelle — spec 006</li>
  <li>Ratio victoire/défaite de l'équipe — spec 007</li>
  <li>Disponibilités et taux de sollicitation — specs 008 et 009</li>
  <li>Tableaux préférés du joueur — spec 010</li>
  <li>Composition de journée — spec 011</li>
</ul>
<%- include("pied") %>
