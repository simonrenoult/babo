<%- include("entete", { titre }) %>
<style>
  /* Les journées : une pastille par rencontre, dont la couleur dit l'état. */
  .journees a::before {
    content: ""; display: inline-block; width: var(--espace-8); height: var(--espace-8); margin-right: var(--espace-4);
    border-radius: 50%; border: 1.5px solid var(--attenue); vertical-align: .05em;
  }
  .journees a.en-cours::before { border-color: var(--attention); background: linear-gradient(90deg, var(--attention) 50%, transparent 50%); }
  .journees a.composee::before { border-color: var(--succes); background: var(--succes); }
  .journees a[aria-current]::before { border-color: currentColor; }
  .journees a[aria-current].composee::before, .journees a[aria-current].en-cours::before { background: currentColor; }

  /* Une carte par match. Le liseré dit l'état, la pastille le nomme. */
  .cartes { display: grid; gap: var(--espace-16); grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); margin: var(--espace-16) 0; }
  .carte {
    --ton: var(--trait-fort);
    padding: var(--espace-16); background: var(--surface);
    border: 1px solid var(--trait); border-left: var(--espace-4) solid var(--ton); border-radius: var(--rayon);
    box-shadow: var(--ombre);
  }
  .carte.incomplet { --ton: var(--attention); }
  .carte.rempli { --ton: var(--succes); }
  .carte.faute { --ton: var(--erreur); background: color-mix(in srgb, var(--erreur) 5%, var(--surface)); }
  .carte header { display: flex; align-items: baseline; gap: var(--espace-8); margin-bottom: var(--espace-8); }
  .carte .code { font-size: 1.05rem; }
  .carte .intitule { color: var(--attenue); font-size: .85rem; flex: 1; }
  .carte .place + .place { margin-top: var(--espace-8); }
  .carte select { width: 100%; }
  .carte .retenu { display: flex; align-items: center; gap: var(--espace-4); margin-top: var(--espace-4); font-size: .88rem; }
</style>
<h2><%= titre %></h2>
<%- include("capitanat-onglets") %>

<% if (calendrier === null) { %>
  <p class="etat">
    Aucun calendrier importé : on compose une rencontre à la fois. Il s'importe
    depuis <a href="/parametres/calendrier">l'écran des paramètres</a>.
  </p>
<% } else { %>
  <%
    const ETATS = { composee: "composée", "en-cours": "en cours", vide: "à composer" };
  %>
  <nav class="onglets sous journees" aria-label="Journées">
    <% for (const autre of calendrier.rencontres) { %>
      <% const etat = etatsDesJournees.get(autre.journee) ?? "vide"; %>
      <a href="/capitanat/planification/<%= autre.journee %>" class="<%= etat %>"
         <%- autre.journee === rencontre.journee ? 'aria-current="page"' : "" %>
         title="<%= autre.debut.toLocaleDateString("fr-FR") %> — <%= ETATS[etat] %>">J<%= String(autre.journee).padStart(2, "0") %><span class="visuellement-cache"> — <%= ETATS[etat] %></span></a>
    <% } %>
  </nav>

  <h3>
    J<%= String(rencontre.journee).padStart(2, "0") %> —
    <%= rencontre.debut.toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long" }) %>
    à <%= heure(rencontre.debut) %> —
    <%= recoitOn(rencontre, calendrier.equipe) ? "reçoit" : "chez" %>
    <% const adversaire = adversaireDe(rencontre, calendrier.equipe); %>
    <abbr title="<%= adversaire.nom %>"><%= sigleDe(adversaire) %></abbr>,
    <a href="https://www.google.com/maps/search/?api=1&amp;query=<%= encodeURIComponent(rencontre.lieu) %>"
       rel="noreferrer noopener" target="_blank"><%= rencontre.lieu %></a>
  </h3>
  <div class="barre-actions">
    <%# Un lien, habillé en bouton : il ouvre le PDF dans un onglet, il ne poste rien. %>
    <span class="geste">
      <a class="bouton" href="/capitanat/planification/<%= rencontre.journee %>/feuille"
         target="_blank" rel="noopener">Imprimer la feuille de rencontre</a>
      <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
        <span>La feuille d'icbad, avec la composition <strong>enregistrée</strong> dans la colonne de
          <%= calendrier.equipe.nom %>. La colonne adverse et les scores restent à remplir à la
          main.</span>
      </span></span>
    </span>
    <% if (texteAPartager !== "") { %>
      <%# Le texte voyage dans l'attribut, échappé par EJS : le script le lit tel quel. %>
      <button type="button" class="copier" data-texte="<%= texteAPartager %>">Copier pour WhatsApp</button>
    <% } %>
  </div>

  <% if (disponibles === 0) { %>
    <p class="etat attention">
      Personne n'est sélectionnable à cette journée : aucun membre rattaché n'a
      répondu oui ou si besoin. Les réponses s'importent depuis
      <a href="/parametres/disponibilites">l'écran des paramètres</a>, et les
      noms du sondage se rattachent sur
      <a href="/capitanat/disponibilites">Disponibilités</a>.
    </p>
  <% } %>

  <% if (fautes.length > 0) { %>
    <div class="etat erreur">
      <strong><%= enregistree ? "La composition enregistrée ne tient plus :" : "Composition non enregistrée :" %></strong>
      <ul>
        <% for (const faute of fautes) { %>
          <li><%= faute %></li>
        <% } %>
      </ul>
    </div>
  <% } else if (enregistree && vides === 0) { %>
    <p class="etat succes">Composition complète et conforme.</p>
  <% } else if (enregistree && vides < postes.length) { %>
    <p class="etat">
      Composition en cours : <%= vides %> place<%= vides > 1 ? "s" : "" %>
      encore vide<%= vides > 1 ? "s" : "" %>.
    </p>
  <% } %>

  <%
    const nomDe = (licence) => membres.find((membre) => membre.licence === licence)?.nom ?? licence;
    const cote = (valeur) => (valeur === null ? "non classé" : `${valeur.toLocaleString("fr-FR")} pts`);
    const retenu = (licence) => {
      const { selections, occasions } = usage.get(licence) ?? { selections: 0, occasions: 0 };
      return occasions === 0 ? "" : ` · retenu ${selections}/${occasions.toLocaleString("fr-FR")}`;
    };
  %>

  <%
    const ETATS_DE_CARTE = {
      vide: ["", "vide"], incomplet: ["attention", "incomplet"], rempli: ["succes", "complet"], faute: ["erreur", "en faute"],
    };
  %>
  <form method="post" action="/capitanat/planification/<%= rencontre.journee %>">
    <div class="cartes">
      <% for (const { match, intitule, places, etat } of cartes) { %>
        <% const [ton, libelle] = ETATS_DE_CARTE[etat]; %>
        <section class="carte <%= etat %>" aria-label="<%= intitule %>">
          <header>
            <strong class="code"><%= match %></strong>
            <span class="intitule"><%= intitule %></span>
            <span class="pastille <%= ton %>"><%= libelle %></span>
          </header>
          <% for (const { poste, choisi, candidats, classement, reponse } of places) { %>
            <div class="place">
              <select name="<%= poste.id %>" aria-label="<%= intitule %> — <%= poste.sexe === "F" ? "dame" : "homme" %>">
                <option value="">— <%= poste.sexe === "F" ? "une dame" : "un homme" %> —</option>
                <% for (const { membre, reponse: repondu, cote: valeur } of candidats) { %>
                  <option value="<%= membre.licence %>" <%= membre.licence === choisi ? "selected" : "" %>>
                    <%= membre.nom ?? membre.licence %> — <%= cote(valeur) %><%= repondu === "si-besoin" ? " (si besoin)" : "" %><%= retenu(membre.licence) %>
                  </option>
                <% } %>
                <%# Un choix que les réponses ne justifient plus reste visible, pour %>
                <%# que la faute ci-dessus désigne quelque chose. %>
                <% if (choisi !== null && !candidats.some(({ membre }) => membre.licence === choisi)) { %>
                  <option value="<%= choisi %>" selected><%= nomDe(choisi) %> — non disponible</option>
                <% } %>
              </select>
              <% if (choisi !== null) { %>
                <div class="retenu">
                  <% if (classement === null) { %>
                    <%- include("lettre", { lettre: "NC" }) %>
                  <% } else { %>
                    <%- include("lettre", { lettre: classement.lettre, cote: classement.cpph }) %>
                  <% } %>
                  <%- include("reponse", { reponse }) %>
                </div>
              <% } %>
            </div>
          <% } %>
        </section>
      <% } %>
    </div>
    <p>
      <button type="submit" class="principal">Enregistrer la composition</button>
      <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
        <span>Les règles de composition :</span>
        <span>• Six matchs : deux simples hommes, un simple dames, un double hommes, un double dames,
          un double mixte.</span>
        <span>• Seuls se sélectionnent les joueurs qui ont répondu <strong>oui</strong> ou <strong>si
          besoin</strong> au sondage de la journée.</span>
        <span>• <strong>Deux matchs au plus</strong> par joueur.</span>
        <span>• Le SH1 n'a pas une moyenne de simple inférieure au SH2.</span>
        <span>• Une composition incomplète s'enregistre, une composition fautive non.</span>
      </span></span>
    </p>
  </form>

  <% if (sollicites.length > 0) { %>
    <h3>Sollicitation des disponibles
      <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
        <span>Combien de fois chaque disponible a été retenu sur les autres journées composées — un «
          si besoin » compte pour une demie. Les moins retenus d'abord : ce sont ceux qu'on
          oublie.</span>
      </span></span>
    </h3>
    <table>
      <tr><th>Joueur</th><th>Au sondage</th><th>Retenu</th><th>Sur</th><th>Taux</th></tr>
      <% for (const { membre, reponse, selections, occasions } of sollicites) { %>
        <tr>
          <td><%= membre.nom ?? membre.licence %></td>
          <td data-tri="<%= { oui: 0, "si-besoin": 1, non: 2 }[reponse] ?? 3 %>"><%- include("reponse", { reponse }) %></td>
          <td><%= selections %></td>
          <td><%= occasions.toLocaleString("fr-FR") %> journée<%= occasions > 1 ? "s" : "" %></td>
          <td data-tri="<%= occasions === 0 ? "" : selections / occasions %>"><%- include("jauge", { selections, occasions }) %></td>
        </tr>
      <% } %>
    </table>
  <% } %>

  <% if (matchsParJoueur.size > 0) { %>
    <h3>Joueurs retenus</h3>
    <table>
      <tr><th>Joueur</th><th>Matchs</th><th>Au sondage</th></tr>
      <% for (const [licence, nombre] of [...matchsParJoueur].toSorted(([un], [autre]) => String(nomDe(un)).localeCompare(String(nomDe(autre)), "fr"))) { %>
        <tr>
          <td><%= nomDe(licence) %></td>
          <td><%= nombre %><% if (nombre > 2) { %> <span class="pastille erreur">trop</span><% } %></td>
          <td data-tri="<%= { oui: 0, "si-besoin": 1, non: 2 }[reponses.get(licence)] ?? 3 %>"><%- include("reponse", { reponse: reponses.get(licence) }) %></td>
        </tr>
      <% } %>
    </table>
  <% } %>
<% } %>
<script>
  // Le presse-papiers demande un contexte sûr (HTTPS ou localhost) ; hors de
  // lui, on retombe sur une zone de texte sélectionnée et `execCommand`.
  for (const bouton of document.querySelectorAll("button.copier")) {
    const libelle = bouton.textContent;
    bouton.addEventListener("click", async () => {
      const texte = bouton.dataset.texte;
      try {
        await navigator.clipboard.writeText(texte);
      } catch {
        const zone = Object.assign(document.createElement("textarea"), { value: texte });
        document.body.append(zone);
        zone.select();
        document.execCommand("copy");
        zone.remove();
      }
      bouton.textContent = "Copié ✓";
      setTimeout(() => (bouton.textContent = libelle), 2000);
    });
  }
</script>
<%- include("pied") %>
