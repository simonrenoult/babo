<%- include("entete", { titre }) %>
<h2><%= titre %></h2>

<h3>Mon classement
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Le classement bouge à la publication hebdomadaire du CPPH.</span>
  </span></span>
</h3>

<%- include("peremption", { fraicheur }) %>

<% if (classement.vuLe === null) { %>
  <p class="etat">
    Aucun relevé : la première passe myffbad n'a pas encore abouti. L'état de la
    source est dans <a href="/parametres">les paramètres</a>.
  </p>
<% } else { %>
  <p class="discret">
    Licence <%= classement.licence %>, relevé le
    <%= classement.vuLe.toLocaleString("fr-FR") %>.
  </p>

  <table>
    <tr><th>Tableau</th><th>Lettre</th><th>CPPH</th></tr>
    <% for (const ligne of classement.lignes) { %>
      <tr>
        <td><%= ligne.discipline %></td>
        <td><%- include("lettre", { lettre: ligne.lettre }) %></td>
        <td><%= ligne.cpph.toLocaleString("fr-FR") %></td>
      </tr>
    <% } %>
  </table>
<% } %>

<h3>Mes prochains tournois
  <span class="infobulle"><button type="button" aria-label="En savoir plus"></button><span class="bulle" role="tooltip">
    <span>Le nom de chaque tournoi mène à sa fiche badnet, seul endroit où une inscription se
      modifie ou s'annule.</span>
  </span></span>
</h3>

<%- include("peremption", { fraicheur: fraicheurDesEngagements }) %>

<% if (tournois.length === 0) { %>
  <p class="etat">
    <% if (engagementsConnus === 0) { %>
      Aucun engagement relevé. En intersaison, c'est normal ; sinon, la session
      badnet est peut-être morte : <a href="/parametres/scrapping/sessions">les paramètres</a>
      le disent et permettent d'en rouvrir une.
    <% } else { %>
      Aucun tournoi à venir. Les <%= engagementsConnus %> engagement<%= engagementsConnus > 1 ? "s" : "" %>
      relevé<%= engagementsConnus > 1 ? "s" : "" %> sont tous passés.
    <% } %>
  </p>
<% } else { %>
  <table>
    <tr><th>Date</th><th>Tournoi</th><th>Lieu</th><th>Engagements</th><th>Inscription</th></tr>
    <% for (const tournoi of tournois) { %>
      <tr>
        <td><%= tournoi.quand %></td>
        <td><a href="<%= tournoi.fiche %>" rel="noreferrer"><%= tournoi.nom %></a></td>
        <td><%= tournoi.lieu ?? "—" %></td>
        <td>
          <%# Le tableau et le partenaire ensemble : un même tournoi se joue en %>
          <%# double *et* en mixte, avec deux partenaires différents, et deux %>
          <%# colonnes parallèles obligeraient à réapparier les deux listes. %>
          <%= tournoi.tableaux.map(intituleDeLEngagement).join(", ") || "—" %>
        </td>
        <td><%= tournoi.statut ?? "—" %></td>
      </tr>
    <% } %>
  </table>

  <% if (tournois.some((tournoi) => tournoi.lieu === null)) { %>
    <p class="etat">
      <strong>Le lieu de certains tournois n'est pas encore relevé.</strong> Il
      se lit sur la fiche publique du tournoi, relevée chaque jour ;
      <a href="/parametres/scrapping/logs">le rapport de la passe</a> dit pourquoi
      une fiche est restée muette.
    </p>
  <% } %>

<% } %>
<%- include("pied") %>
